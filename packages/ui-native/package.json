{
  "name": "@abonten/ui-native",
  "version": "0.0.0",
  "private": true,
  "description": "Shared React Native / Expo UI primitives, theme provider, and i18n provider for the Abonten mobile app. Consumes @abonten/ui-tokens and @abonten/i18n so web and native stay visually and textually in sync.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./theme": "./src/theme/index.ts",
    "./i18n": "./src/i18n/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@abonten/i18n": "*",
    "@abonten/ui-tokens": "*"
  },
  "peerDependencies": {
    "@expo/vector-icons": "*",
    "expo-image": "*",
    "expo-secure-store": "*",
    "nativewind": ">=4",
    "react": "*",
    "react-native": "*",
    "react-native-svg": "*"
  },
  "devDependencies": {
    "@abonten/config": "*",
    "@types/react": "*",
    "typescript": "^5"
  }
}
