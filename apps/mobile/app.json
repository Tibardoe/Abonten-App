{
  "expo": {
    "name": "Abonten",
    "slug": "abonten",
    "scheme": "abonten",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "backgroundColor": "#121410",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.abonten.app",
      "appleTeamId": "KDDBR5P4D6",
      "associatedDomains": ["applinks:abontenhub.com"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.abonten.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121410"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "abontenhub.com",
              "pathPrefix": "/events"
            },
            {
              "scheme": "https",
              "host": "abontenhub.com",
              "pathPrefix": "/places"
            },
            {
              "scheme": "https",
              "host": "abontenhub.com",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "https",
              "host": "abontenhub.com",
              "pathPrefix": "/weekly"
            },
            {
              "scheme": "https",
              "host": "abontenhub.com",
              "pathPrefix": "/spotlight"
            },
            {
              "scheme": "https",
              "host": "abontenhub.com",
              "pathPrefix": "/stories"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-system-ui",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-web-browser",
      "expo-image",
      "expo-sharing",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-mark.png",
          "resizeMode": "contain",
          "imageWidth": 192,
          "backgroundColor": "#121410",
          "dark": {
            "image": "./assets/splash-mark.png",
            "backgroundColor": "#121410"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4FD9C4"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Euclid-Circular-B-Light.ttf",
            "./assets/fonts/Euclid-Circular-B-Regular.ttf",
            "./assets/fonts/Euclid-Circular-B-Medium.ttf",
            "./assets/fonts/Euclid-Circular-B-SemiBold.ttf",
            "./assets/fonts/Euclid-Circular-B-Bold.ttf"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Abonten needs access to your photos so you can set a profile picture."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Abonten uses the camera so organizers can scan ticket QR codes to check attendees in."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Abonten uses the microphone so you can record and send voice messages in chat.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Abonten uses your location to show events and places near you, to help you pick a venue on the map, and to record a visit when you check in at a place.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": "Abonten does not use motion and fitness data. This description is required because the location component the app is built with includes optional motion-activity support, which Abonten never turns on."
        }
      ],
      "expo-video",
      "./plugins/withPictureInPictureManifest",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "abonten-hub",
          "project": "abonten-mobile"
        }
      ],
      "./plugins/withAndroidNativeBuildFix",
      "./plugins/withAndroidMinification"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c0a45056-182f-47c5-b862-de14034a830a"
      }
    },
    "owner": "abonten-hub"
  }
}
