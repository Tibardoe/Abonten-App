{
  "expo": {
    "name": "Abonten",
    "slug": "abonten",
    "scheme": "abonten",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.abonten.app"
    },
    "android": {
      "package": "com.abonten.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser",
      "expo-image",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
