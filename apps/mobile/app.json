{
  "expo": {
    "name": "Abonten",
    "slug": "abonten",
    "scheme": "abonten",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.abonten.app"
    },
    "android": {
      "package": "com.abonten.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4FD9C4"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser",
      "expo-image",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#0B0B0B"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4FD9C4"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Euclid-Circular-B-Light.ttf",
            "./assets/fonts/Euclid-Circular-B-Regular.ttf",
            "./assets/fonts/Euclid-Circular-B-Medium.ttf",
            "./assets/fonts/Euclid-Circular-B-SemiBold.ttf",
            "./assets/fonts/Euclid-Circular-B-Bold.ttf"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Abonten needs access to your photos so you can set a profile picture."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c0a45056-182f-47c5-b862-de14034a830a"
      }
    },
    "owner": "abonten-hub"
  }
}
