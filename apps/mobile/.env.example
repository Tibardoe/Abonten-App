# Copy to apps/mobile/.env and fill in. Only PUBLIC values belong here —
# EXPO_PUBLIC_* is inlined into the app bundle, so never put a secret
# (service-role key, Paystack secret, Hubtel/Resend/Twilio credentials) in
# this file. Those stay server-side behind /api/mobile/**.

# Supabase project (same project as the web app) — public URL + anon key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Origin of the web deployment that serves /api/mobile/** (no trailing slash).
EXPO_PUBLIC_API_BASE_URL=https://abonten-benjamin-tibardoes-projects.vercel.app

# Later phases:
# EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
# EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
