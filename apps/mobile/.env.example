# Copy to apps/mobile/.env and fill in. Only PUBLIC values belong here —
# EXPO_PUBLIC_* is inlined into the app bundle, so never put a secret
# (service-role key, Paystack secret, Hubtel/Resend/Twilio credentials) in
# this file. Those stay server-side behind /api/mobile/**.
#
# This file is only read by local dev (`expo start`). EAS Build/Update do
# NOT read it — they resolve all three vars below from the project's EAS
# environment variables (development / preview / production), set with
# `eas env:set`. Keep the two in sync.

# Supabase project (same project as the web app) — public URL + anon key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Origin of the web deployment that serves /api/mobile/** (no trailing slash).
# Point this at a branch/preview deployment while developing if you need to.
EXPO_PUBLIC_API_BASE_URL=https://abontenhub.com

# Sentry (crash/error monitoring) — the `abonten-mobile` project's public
# DSN. Safe to inline into the bundle. Sentry is disabled in dev (`__DEV__`)
# regardless, so this can be left blank locally.
#   - the DSN is a PUBLIC value → EXPO_PUBLIC_ prefix, set per EAS env
#   - SENTRY_AUTH_TOKEN is a BUILD-ONLY secret → NOT here, NOT EXPO_PUBLIC_;
#     add it as an EAS secret (sensitive) so `eas build` can upload source
#     maps. It is never bundled into the app.
EXPO_PUBLIC_SENTRY_DSN=
# Optional: overrides the environment tag (defaults to "production" in a
# release build). e.g. set to "preview" for the preview EAS env.
# EXPO_PUBLIC_SENTRY_ENVIRONMENT=

# Later phases:
# EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
# EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
