{
  "extends": "@abonten/config/tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "src/app/[locale]/(pages)/(settings)/settings/membership",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
