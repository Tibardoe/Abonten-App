# Abonten Hub — apps/web
#
# This file documents the Sentry-related environment variables only. The
# app's other secrets (Supabase, Cloudinary, Resend, Twilio, Hubtel,
# Google, Paystack, OBSERVABILITY_INGEST_SECRET, …) are managed in
# .env.local for local dev and in the Vercel project settings for
# deployments — they are intentionally not listed here.
#
# Email OTP sign-in (added 2026-09-08) adds NO new environment variable to
# this app. It uses supabase.auth.signInWithOtp / verifyOtp with the anon
# key already configured. The authentication emails are sent by Supabase
# Auth via custom SMTP (Resend), configured in the Supabase dashboard's
# Auth → SMTP settings — that Resend credential lives ONLY there, never in
# this app's env. See docs/architecture/email-auth.md.

# ── Sentry (error monitoring) ────────────────────────────────
# Public DSN for the `abonten-web` Sentry project. Safe to expose to the
# browser — it only identifies where events are sent, it grants nothing.
# Set the same value for both; SENTRY_DSN is the server-side fallback.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Server-only. Used by the build to upload source maps and create the
# release. NEVER prefix with NEXT_PUBLIC_ and never commit a real value.
# Set it in CI / Vercel only; local `next build` works without it (upload
# is simply skipped).
SENTRY_AUTH_TOKEN=

# Optional. Overrides the environment tag on events. When unset the SDK
# uses VERCEL_ENV ("production" / "preview") then NODE_ENV. Sentry only
# sends at all when NODE_ENV === "production", so local dev is never
# reported regardless of this value.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# ── Field Ops (regional promotion programme) ─────────────────
# Emergency stop for the Field Ops module (mirrors REWARDS_KILL_SWITCH).
# "true" hides the team members' /field area and refuses every member /
# team-lead write on this deployment. Leave unset normally.
FIELD_OPS_KILL_SWITCH=

# ── Discovery (unified search, alerts and recommendations) ───
# Emergency stops. "true" wins over Admin > Discovery > Settings on this
# deployment. SEARCH_V2_KILL_SWITCH puts every surface back on the old
# events-only search. RECOMMENDATIONS_KILL_SWITCH hides prompts, alerts and
# For you, and refuses new subscriptions; to also stop the database jobs and
# queued pushes, untick "Recommendation engine switched on" in the admin
# console. Leave unset normally.
SEARCH_V2_KILL_SWITCH=
RECOMMENDATIONS_KILL_SWITCH=
