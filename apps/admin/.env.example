# Abonten Admin Console — apps/admin
#
# Deploy as its own Vercel project (internal subdomain, e.g. admin.abonten.*).
# The SERVICE ROLE key lives ONLY in this project's env — never in apps/web
# client bundles, never in apps/mobile.

# Same Supabase project as apps/web
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated allowlist of emails that may even reach the console.
# A person still needs an active admin_user row + roles to do anything.
ADMIN_EMAIL_ALLOWLIST=you@abonten.example

# Where this console is served (used for the OAuth redirect)
NEXT_PUBLIC_ADMIN_URL=http://localhost:3100

# Shared secret the observability ingest/health routes require from
# server-to-server callers (pg_cron, the web app). Generate a long random
# value; set the SAME value in apps/web's env.
OBSERVABILITY_INGEST_SECRET=

# ── Sentry (error monitoring) ────────────────────────────────
# Public DSN for the `abonten-admin` Sentry project — a DIFFERENT value
# from apps/web's DSN. Safe to expose to the browser. Set both; SENTRY_DSN
# is the server-side fallback.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Server-only. Used by the build to upload source maps + create the
# release. This is an ORG-level Sentry token — reuse the SAME value already
# set for apps/web (it works for every project in the org). Never prefix
# with NEXT_PUBLIC_, never commit a real value; set it in CI / Vercel only.
# Local `next build` works without it (upload is skipped).
SENTRY_AUTH_TOKEN=

# Optional. Overrides the environment tag on events. When unset the SDK
# uses VERCEL_ENV then NODE_ENV. Sentry only sends at all when
# NODE_ENV === "production", so local dev is never reported.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
