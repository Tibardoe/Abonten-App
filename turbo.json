{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "CLOUDINARY_API_KEY",
        "CLOUDINARY_API_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "HUBTEL_API_CLIENT_ID",
        "HUBTEL_API_CLIENT_SECRET",
        "NEXTAUTH_SECRET",
        "NEXTAUTH_URL",
        "OBSERVABILITY_INGEST_SECRET",
        "PAYSTACK_SECRET_KEY",
        "RESEND_API_KEY",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_DSN",
        "SUPABASE_SERVICE_ROLE_KEY"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
