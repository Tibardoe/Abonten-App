{
  "name": "abonten",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "web": "npm run -w @abonten/web",
    "web:dev": "npm run dev -w @abonten/web",
    "web:build": "npm run build -w @abonten/web"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "lefthook": "^1.10.10",
    "turbo": "^2.5.8"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
